# Evidex environment settings. Copy this file to .env (git-ignored) and edit:
#   Copy-Item .env.example .env        (PowerShell)
# Real environment variables win over this file. Values here override config.yaml;
# the Settings page marks them "Set in .env". Restart the API after editing.
# Everything stays local unless you set EVIDEX_ALLOW_REMOTE=true (see the bottom).

# ---------------------------------------------------------------------------------
# 1. Default: local Ollama (nothing to set). Uncomment to change the URL or models.
# ---------------------------------------------------------------------------------
# EVIDEX_OLLAMA_BASE_URL=http://localhost:11434
# EVIDEX_ANSWER_MODEL=qwen2.5:7b-instruct
# EVIDEX_EMBEDDING_MODEL=nomic-embed-text
# Ollama behind a reverse proxy that needs a token:
# EVIDEX_LLM_API_KEY=

# ---------------------------------------------------------------------------------
# 2. Any OpenAI-compatible server for answers (LM Studio, llama.cpp, vLLM, LocalAI…)
# ---------------------------------------------------------------------------------
# EVIDEX_LLM_PROVIDER=openai
# EVIDEX_LLM_BASE_URL=http://localhost:1234/v1      # LM Studio
# EVIDEX_LLM_BASE_URL=http://localhost:8080/v1      # llama.cpp server
# EVIDEX_LLM_BASE_URL=http://localhost:8000/v1      # vLLM (move Evidex to another port)
# EVIDEX_LLM_API_KEY=                               # only if the server asks for one
# EVIDEX_ANSWER_MODEL=qwen2.5-7b-instruct           # the model id the server lists

# ---------------------------------------------------------------------------------
# 3. Embeddings from a different place (default: the same endpoint as answers)
# ---------------------------------------------------------------------------------
# EVIDEX_EMBED_PROVIDER=ollama
# EVIDEX_EMBED_BASE_URL=http://localhost:11434
# EVIDEX_EMBED_API_KEY=
# EVIDEX_EMBEDDING_MODEL=nomic-embed-text
# nomic-embed-text needs these prefixes (the defaults). Most other embedding models
# want none: set both to empty. Changing the embedding model needs a re-index.
# EVIDEX_EMBEDDING_QUERY_PREFIX="search_query: "
# EVIDEX_EMBEDDING_DOC_PREFIX="search_document: "

# ---------------------------------------------------------------------------------
# 4. Reranker (runs in Python; downloaded once from Hugging Face)
# ---------------------------------------------------------------------------------
# EVIDEX_RERANKER_ENABLED=true
# EVIDEX_RERANKER_MODEL=BAAI/bge-reranker-base
# HF_TOKEN=                                          # only for gated or private models
# HF_HUB_OFFLINE=1                                   # after the first download: never go online

# ---------------------------------------------------------------------------------
# 5. Other
# ---------------------------------------------------------------------------------
# EVIDEX_TIMEOUT_SECONDS=120
# EVIDEX_NUM_CTX=4096                                # Ollama only
# EVIDEX_VECTOR_STORE=./data/chroma
# EVIDEX_SQLITE=./data/app.db
# EVIDEX_CONFIG=C:\projects\evidex\config.yaml

# ---------------------------------------------------------------------------------
# 6. Remote / hosted APIs. OFF by default: the project rule is that everything runs
#    locally. Turning this on sends your documents' text to that service.
# ---------------------------------------------------------------------------------
# EVIDEX_ALLOW_REMOTE=true
# EVIDEX_LLM_PROVIDER=openai
# EVIDEX_LLM_BASE_URL=https://api.openai.com/v1
# EVIDEX_LLM_API_KEY=sk-...
# EVIDEX_ANSWER_MODEL=gpt-4o-mini
