{
  "name": "evidex-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "gen:types": "openapi-typescript http://localhost:8000/openapi.json -o src/types/api.ts",
    "gen:types:file": "openapi-typescript ./openapi.json -o src/types/api.ts"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.0",
    "@fontsource/plus-jakarta-sans": "^5.2.0",
    "@fontsource/poppins": "^5.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.8.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
